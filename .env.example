# Copy this file to ".env" (Copy-Item .env.example .env) and fill in the values marked REQUIRED.
# Never commit .env - it contains your passwords.

# ---- Neo4j (graph database) -------------------------------------------------
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
# REQUIRED: the password you set for your Neo4j instance
NEO4J_PASSWORD=
# Dedicated database for the platform (Enterprise edition). Community edition falls back to "neo4j" automatically.
NEO4J_DATABASE=ctpip
# Optional least-privilege account used for all query-time reads (created automatically). Leave empty to skip.
NEO4J_READ_USER=
NEO4J_READ_PASSWORD=
# Optional but recommended: lets start.bat start Neo4j for you.
#   NEO4J_HOME      = folder of your Neo4j instance (contains bin, conf, data)
#   NEO4J_JAVA_HOME = Java 21 runtime folder (Neo4j Desktop ships one under ...\Neo4jDesktop2\Cache\runtime\zulu21...)
NEO4J_HOME=
NEO4J_JAVA_HOME=
QUERY_TIMEOUT_S=15
QUERY_RESULT_LIMIT=400

# ---- Web server ----------------------------------------------------------------
# start.bat uses this port, or the next free one if another program already uses it
BACKEND_PORT=8000
# If set, every /api request must send header X-API-Token with this value
API_TOKEN=

# ---- Ingestion ----------------------------------------------------------------
INGEST_WORKERS=4
OCR_ENABLED=true
TABLE_DETECTION=true
MAX_UPLOAD_MB=200
# First start on a new computer: when no documents are stored yet, read every PDF in the dataset folders automatically
AUTO_IMPORT_ON_EMPTY=true
# Folder scanned by "Load dataset folder" (defaults to the project folder; docs/, backend/, frontend/, data/ are skipped)
# IMPORT_DIR=

# ---- Local AI assistant (optional; install Ollama from https://ollama.com) ---------
# Defaults for the Settings page (changes made there are saved in the app and override these).
AI_ENABLED=true
# ollama (native Ollama API) | openai (any OpenAI-compatible server such as LM Studio or llama.cpp)
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5:3b fits a 4 GB graphics card; qwen2.5:7b or llama3.1:8b write better answers on larger cards
AI_MODEL=qwen2.5:3b
AI_TEMPERATURE=0.2
AI_CONTEXT_TOKENS=8192

# ---- Optional AI use during extraction (advanced; off by default) -------------------
# rules | openai_compatible     (openai_compatible sends protocol text to LLM_BASE_URL during ingestion)
EXTRACTION_PROVIDER=rules
# none | openai_compatible      (rewording of graph-search summaries; the AI toggles in the app do not need this)
ANSWER_PROVIDER=none
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=
LLM_API_KEY=
